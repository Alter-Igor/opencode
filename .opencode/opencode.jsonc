{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  // CAS admin/approval tools must never be exercised from this coding shell.
  // Tool names: sanitize(server) + "_" + sanitize(tool) → alterspective-agent_cas_*
  "permission": {
    "alterspective-agent_cas_resolve_tool_call": "deny",
    "alterspective-agent_cas_admin_*": "deny",
    // 49 per-agent shortcuts duplicate keystone-dynamic cas_0ab2b1__agent_* (BFA-007).
    // Keep the cas-safe-* bridge here (not proxied by the dynamic connection).
    "alterspective-agent_agent_*": "deny",
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "synapse-coder": {
      "type": "remote",
      "url": "https://staging.synapse-coder-mcp.alterspective.com.au/mcp",
      "headers": {
        "Authorization": "Bearer {env:SYNAPSE_CODER_STAGING_BEARER_TOKEN}",
      },
    },
    "alterspective-rag": {
      "type": "remote",
      "url": "https://rag.alterspective.com.au/mcp",
      "headers": {
        "Authorization": "Bearer {env:ALTERSPECTIVE_RAG_MCP_API_KEY}",
      },
    },
    // Central Agent Service (CAS) — specialised business agents.
    // OAuth: `opencode mcp auth alterspective-agent` (browser PKCE; tokens in mcp-auth.json).
    // Optional override: CAS_MCP_TOKEN env (not required when OAuth succeeds).
    // Do NOT set a static empty Authorization header — it blocks OAuth discovery.
    // Prefer cas_safe_* tools for allowlist + size caps; use /cas slash command to list+select.
    "alterspective-agent": {
      "type": "remote",
      "url": "https://agent.alterspective.com.au/api/v1/mcp",
      "oauth": {
        "scope": "cas.access",
        "callbackPort": 19876,
      },
    },
    "keystone": {
      // Disabled 2026-09-19: ~102 static tool schemas duplicated by keystone-dynamic
      // (BFA-007 — route AI-tool MCP access through Keystone /mcp/dynamic).
      "type": "remote",
      "url": "https://identity.alterspective.com.au/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:KEYSTONE_AI_ADMIN_API_KEY}",
      },
      "enabled": false,
    },
    "timely": {
      "type": "remote",
      "url": "https://timely-mcp.alterspective.com.au/mcp",
    },
    "sharedo": {
      // Disabled 2026-09-19: Sharedo tenants are Keystone credential providers
      // and reachable via keystone-dynamic (BFA-007). The direct remote MCP asked
      // for a second, separate sign-in.
      "type": "remote",
      "url": "https://sharedo-api.alterspective.com.au/mcp",
      "enabled": false,
    },
    "vault-local": {
      "type": "local",
      "command": ["node", "C:/GitHub/vault-mcp/dist/index.js"],
      "enabled": true,
    },
    // azure-devops removed 2026-09-19: local npx server died without AZURE_DEVOPS_PAT
    // (-32000). Follow-up: onboard Azure DevOps as a Keystone credential provider +
    // AI Connection so it is reached via keystone-dynamic (BFA-007), not a per-repo PAT.
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
