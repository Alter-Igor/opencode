{
  "name": "@alterspective/opencode-delegate",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP bridge that lets AI clients delegate coding work to sandboxed OpenCode sessions (FEAT-OCD-001).",
  "bin": {
    "opencode-delegate": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts mcp",
    "doctor": "bun src/cli.ts doctor",
    "watch": "bun src/cli.ts watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:w3": "bun spike/e2e-w3.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
